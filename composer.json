{
    "name": "vrpayment/plugin-core",
    "description": "Core functionality for the VRPayment plugins.",
    "type": "library",
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "VRPayment\\PluginCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VRPayment\\PluginCore\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.2",
        "vrpayment/sdk": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.88",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit"
    }
}